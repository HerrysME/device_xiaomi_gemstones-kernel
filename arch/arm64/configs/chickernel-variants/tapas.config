# SPDX-License-Identifier: GPL-2.0-only
#
# tapas (Xiaomi Redmi Note 12 4G) specific configuration
#
# Merged on top of chickernel_defconfig + ksun.susfs.config by
# build.config.gki.aarch64.chickernel.ksun.susfs.tapas
#

# Subsystem removal
# CONFIG_NFC is not set
# CONFIG_GNSS is not set

# Explicitly keep power-supply debug logging off (battery stats kmsg spam
# from sm5602/nopmi vendor modules is filtered by the kernel's
# filtered_modules[] mechanism in kernel/printk/printk.c)
# CONFIG_POWER_SUPPLY_DEBUG is not set

# Modem / radio / NFC vendor module blacklist
#
# The modem stack (IPA data path, MPSS remoteproc, QRTR control channel)
# lives in prebuilt vendor_dlkm modules on tapas. The kernel image cannot
# remove them at compile time, so they are blocked at module-load time via
# the module_blacklist= cmdline.
#
# TIER "safe"  (keep calls/SMS/IMEI/GPS, kill mobile data + NFC only):
#   ipa3,ipa,rmnet_core,rmnet_ctl,rmnet_perf,rmnet_dlc,datactl,dpl,nq-nci,nq_nci
#
# TIER "full"  (default - kill modem, IMEI exposure, GPS, NFC):
#   adds qcom_q6v5_pas,qrtr,qrtr-smd,qrtr_smd,mhi,mhi_net
#   WARNING: on SDM685 audio (ADSP) is booted by the same qcom_q6v5_pas
#   vendor module and parts of the audio/PDR stack talk over QRTR.
#   If speaker/mic/camera die with this tier, fall back to "safe".
#
# "@@MODEM_BLACKLIST@@" is replaced by CI (build-tapas.yml) or kept as-is
# (comma is not allowed in the placeholder replacement below; keep the
# placeholder intact for manual builds and edit the list yourself).
CONFIG_CMDLINE="stack_depot_disable=on kasan=off kvm-arm.mode=protected cgroup_disable=pressure module_blacklist=ipa3,ipa,rmnet_core,rmnet_ctl,rmnet_perf,rmnet_dlc,datactl,dpl,nq-nci,nq_nci,qcom_q6v5_pas,qrtr,qrtr-smd,qrtr_smd,mhi,mhi_net"

CONFIG_LOCALVERSION="-chickernel-tapas-7-ksun-susfs"
